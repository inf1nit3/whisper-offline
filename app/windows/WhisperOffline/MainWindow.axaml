<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WhisperOffline"
        x:Class="WhisperOffline.MainWindow"
        Title="Whisper Offline"
        Width="640" Height="560"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Sprache:" VerticalAlignment="Center" />
            <ComboBox x:Name="LanguageBox" SelectedIndex="0" Width="130">
                <ComboBoxItem Content="Automatisch" Tag="auto" />
                <ComboBoxItem Content="Deutsch" Tag="de" />
                <ComboBoxItem Content="English" Tag="en" />
            </ComboBox>
            <TextBlock Text="Modell:" VerticalAlignment="Center" Margin="16,0,0,0" />
            <ComboBox x:Name="ModelBox" MinWidth="220" SelectionChanged="OnModelSelected" />
            <TextBlock x:Name="ModelLabel" Text="" VerticalAlignment="Center"
                       Foreground="Gray" FontSize="12" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
            <Button x:Name="RecordButton" Content="&#127908;  Aufnahme starten" MinWidth="170"
                    Click="OnRecordClick" />
            <Button x:Name="FileButton" Content="&#128196;  Datei transkribieren…" MinWidth="180"
                    Click="OnFileClick" />
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="StatusLabel" Text="" Margin="0,12,0,0"
                   Foreground="Gray" TextWrapping="Wrap" />

        <TextBox Grid.Row="3" x:Name="TranscriptBox" Margin="0,12,0,0"
                 AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="False"
                 Watermark="Hier erscheint die Transkription…" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0"
                    HorizontalAlignment="Right">
            <Button Content="Kopieren" Click="OnCopyClick" />
            <Button Content="Leeren" Click="OnClearClick" />
        </StackPanel>
    </Grid>
</Window>
