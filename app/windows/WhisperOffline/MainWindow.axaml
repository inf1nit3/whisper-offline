<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WhisperOffline.MainWindow"
        Title="Scheisssewasser's Whisper"
        Width="820" Height="700"
        MinWidth="640" MinHeight="520"
        Background="{DynamicResource BrandSurfaceBrush}"
        xmlns:local="using:WhisperOffline"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- Aufnahmeknopf wird während der Aufnahme rot -->
        <Style Selector="Button.recording /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.recording:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#B91C1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>

    <Grid>
        <!-- Hauptansicht (analog zur Android-Scaffold-Struktur) -->
        <Grid x:Name="MainPanel" RowDefinitions="Auto,Auto,Auto,*" Margin="20,16">
            <!-- TopAppBar: Titel links, Schnellnavigation rechts -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
                    <TextBlock Text="Scheisssewasser's" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrandPrimaryBrush}" />
                    <TextBlock Text="Whisper" FontSize="22" FontWeight="Bold">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                <GradientStop Color="#7CB8F7" Offset="0" />
                                <GradientStop Color="#38BDF8" Offset="1" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
                <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
                    <Button x:Name="UpdateButton" Classes="chip" Content="&#11014;  Update" Click="OnCheckUpdate" IsVisible="False" />
                    <Button Classes="chip" Content="&#128101;  Meeting" Click="OnOpenMeeting" />
                    <Button Classes="chip" Content="&#128194;  Stapel" Click="OnOpenBatch" />
                    <Button Classes="chip" Content="&#128218;  Verlauf" Click="OnOpenHistory" />
                    <Button Classes="chip" Content="&#128214;  Wörterbuch" Click="OnOpenDictionary" />
                    <Button Classes="chip" Content="&#128202;  Statistik" Click="OnOpenStats" />
                    <Button Classes="chip" Content="&#9881;  Einstellungen" Click="OnOpenSettings" />
                    <Button Classes="chip" Content="&#128220;" ToolTip.Tip="Changelog" Click="OnOpenChangelog" />
                </WrapPanel>
            </Grid>

            <!-- Chip-Leiste: Modell, Sprache, Übersetzen & Hotkey -->
            <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" Margin="0,0,0,12">
                <Button Classes="chip" Click="OnOpenModelPicker" ToolTip.Tip="Sprachmodell wählen oder herunterladen">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#9881;" VerticalAlignment="Center" />
                        <TextBlock x:Name="ModelLabel" Text="Modell wählen…" VerticalAlignment="Center" FontWeight="Medium" />
                        <TextBlock Text="&#9662;" VerticalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                </Button>

                <ComboBox x:Name="LanguageBox" SelectedIndex="0" Width="175" CornerRadius="18">
                    <ComboBoxItem Content="Deutsch" Tag="de" />
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="Automatisch (2× so lang)" Tag="auto" />
                </ComboBox>

                <CheckBox x:Name="TranslateBox" Content="→ EN" Click="OnTranslateChanged"
                          VerticalAlignment="Center" Margin="4,0"
                          ToolTip.Tip="Ins Englische übersetzen (nur Whisper-Modelle)" />

                <Border Background="{DynamicResource BrandCardBackgroundBrush}"
                        BorderBrush="{DynamicResource BrandCardBorderBrush}"
                        BorderThickness="1" CornerRadius="18" Padding="10,2">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Hotkey:" FontSize="12" Foreground="{DynamicResource BrandSubtleTextBrush}" VerticalAlignment="Center" />
                        <Button x:Name="HotkeyButton" Padding="8,3" CornerRadius="12" Click="OnHotkeyCapture"
                                ToolTip.Tip="Anklicken, dann die gewünschte Kombination drücken" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Aufnahme-Steuerung + Wellenform + Fortschrittskarte -->
            <Border Grid.Row="2" Classes="card" Margin="0,0,0,12">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button x:Name="RecordButton" Classes="primaryAction" Content="&#127908;  Aufnahme starten"
                                    MinWidth="195" Height="46" Click="OnRecordClick" />
                            <Button x:Name="FileButton" Classes="chip" Content="&#128196;  Audiodatei transkribieren…"
                                    Height="42" Click="OnFileClick" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <CheckBox x:Name="AutostartBox" Content="Autostart" Click="OnAutostartChanged"
                                      ToolTip.Tip="Mit Windows im Infobereich starten" />
                            <CheckBox x:Name="StartMinimizedBox" Content="Minimiert" Click="OnStartMinimizedChanged"
                                      ToolTip.Tip="Beim Start direkt in den Infobereich minimieren" />
                        </StackPanel>
                    </Grid>

                    <Border Classes="waveStage">
                        <local:WaveformView x:Name="Waveform" Height="44" />
                    </Border>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Name="StatusLabel" Text="" FontWeight="Medium" TextWrapping="Wrap" />
                            <TextBlock x:Name="HotkeyHint" FontSize="12" Foreground="{DynamicResource BrandSubtleTextBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="HotkeyMoreLabel" FontSize="12" Foreground="{DynamicResource BrandSubtleTextBrush}" TextWrapping="Wrap" IsVisible="False" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="EngineLabel" Text="" FontSize="11"
                                   Foreground="{DynamicResource BrandSubtleTextBrush}" VerticalAlignment="Bottom" />
                    </Grid>

                    <!-- Fortschritt der laufenden Transkription -->
                    <Grid x:Name="WorkPanel" ColumnDefinitions="*,Auto,Auto" IsVisible="False" Margin="0,4,0,0">
                        <ProgressBar x:Name="WorkProgress" Grid.Column="0" Minimum="0" Maximum="1"
                                     Height="6" MinWidth="0" VerticalAlignment="Center" />
                        <TextBlock x:Name="WorkDetail" Grid.Column="1" Margin="12,0,0,0" FontSize="12"
                                   Foreground="{DynamicResource BrandSubtleTextBrush}" VerticalAlignment="Center" />
                        <Button x:Name="WorkCancelButton" Grid.Column="2" Classes="chip" Content="Abbrechen"
                                Margin="12,0,0,0" Click="OnWorkCancel" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- TranscriptCard (analog zu TranscriptCard in Components.kt) -->
            <Border Grid.Row="3" Classes="card">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="📝" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Text="Transkript" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="· Schließen legt die App in den Infobereich" FontSize="12"
                                       Foreground="{DynamicResource BrandSubtleTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="TransformButton" Classes="chip" Content="&#10024;  Umformen" Click="OnTransformTranscript"
                                    ToolTip.Tip="Transkript mit dem Sprachmodell verbessern, kürzen, übersetzen …" />
                            <Button Classes="chip" Content="&#128203;  Kopieren" Click="OnCopyClick" />
                            <Button Classes="chip" Content="&#128279;  Teilen" Click="OnShareClick">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="WhatsApp" Click="OnShareWhatsApp" />
                                        <MenuItem Header="E-Mail" Click="OnShareMail" />
                                        <MenuItem Header="In Zwischenablage kopieren" Click="OnCopyClick" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Classes="chip" Content="Leeren" Click="OnClearClick" />
                        </StackPanel>
                    </Grid>

                    <TextBox Grid.Row="1" x:Name="TranscriptBox"
                             AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="False"
                             BorderThickness="0" Background="Transparent" FontSize="14"
                             Watermark="Aufnehmen, eine Audiodatei wählen oder per Hotkey überall diktieren…" />
                </Grid>
            </Border>
        </Grid>

        <!-- Einführung beim ersten Start -->
        <Border x:Name="OnboardingPanel" IsVisible="False" Background="{DynamicResource BrandSurfaceBrush}">
            <Grid RowDefinitions="Auto,*,Auto" Margin="32" MaxWidth="640" HorizontalAlignment="Center">
                <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
                    <TextBlock Text="Scheisssewasser's Whisper" FontSize="26" FontWeight="Bold" />
                    <TextBlock x:Name="OnboardingPageIndicator" Text="Seite 1 von 4"
                               Foreground="{DynamicResource BrandSubtleTextBrush}" FontSize="13" />
                </StackPanel>
                <Border Grid.Row="1" Classes="card" Padding="24">
                    <ScrollViewer>
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="OnboardingTitle" Text="" FontSize="20" FontWeight="Bold" />
                            <TextBlock x:Name="OnboardingIntro" TextWrapping="Wrap" IsVisible="False" FontSize="14" />
                            <StackPanel x:Name="OnboardingBullets" Spacing="8" />
                            <TextBlock x:Name="OnboardingFooter" TextWrapping="Wrap" IsVisible="False"
                                       Foreground="{DynamicResource BrandSubtleTextBrush}" FontSize="12" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Button x:Name="OnboardingNextButton" Grid.Row="2" Classes="primaryAction" Content="Weiter"
                        Click="OnOnboardingNext" MinWidth="220" Height="44"
                        HorizontalAlignment="Center" Margin="0,16,0,0" />
            </Grid>
        </Border>

        <!-- Changelog -->
        <Border x:Name="ChangelogPanel" IsVisible="False" Background="{DynamicResource BrandSurfaceBrush}">
            <Grid RowDefinitions="Auto,*" Margin="24" MaxWidth="760" HorizontalAlignment="Stretch">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <TextBlock Text="Changelog" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="chip" Content="&#10005;  Schließen" Click="OnChangelogClose" />
                </Grid>
                <Border Grid.Row="1" Classes="card">
                    <ScrollViewer>
                        <TextBlock x:Name="ChangelogText" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- Update mit Release-Notes -->
        <Border x:Name="UpdatePanel" IsVisible="False" Background="{DynamicResource BrandSurfaceBrush}">
            <Grid RowDefinitions="Auto,*,Auto" Margin="24" MaxWidth="760" HorizontalAlignment="Stretch">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <TextBlock x:Name="UpdateTitle" Text="Update" FontSize="22"
                               FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="chip" Content="Abbrechen" Click="OnUpdateCancel" />
                </Grid>
                <Border Grid.Row="1" Classes="card">
                    <ScrollViewer>
                        <TextBlock x:Name="UpdateNotes" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
                <Button x:Name="UpdateInstallButton" Grid.Row="2" Classes="primaryAction"
                        Content="Herunterladen &amp; installieren"
                        Click="OnUpdateInstall" Margin="0,12,0,0" HorizontalAlignment="Left" />
            </Grid>
        </Border>

        <!-- Overlay-Scaffold (Einstellungen, Wörterbuch, Statistik, Meeting, Stapel …) -->
        <Border x:Name="PanelHost" IsVisible="False" Background="{DynamicResource BrandSurfaceBrush}">
            <Grid RowDefinitions="Auto,*" Margin="24,20,24,16" MaxWidth="780" HorizontalAlignment="Stretch">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock x:Name="PanelTitle" FontSize="22" FontWeight="Bold" />
                        <TextBlock x:Name="PanelSubtitle" FontSize="12"
                                   Foreground="{DynamicResource BrandSubtleTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <StackPanel x:Name="PanelActions" Orientation="Horizontal" Spacing="8" />
                        <Button Classes="chip" Content="&#10005;  Schließen" Click="OnPanelClose" />
                    </StackPanel>
                </Grid>
                <ContentControl Grid.Row="1" x:Name="PanelContent" />
            </Grid>
        </Border>

        <!-- Modell-Auswahl -->
        <Border x:Name="PickerPanel" IsVisible="False" Background="{DynamicResource BrandSurfaceBrush}">
            <Grid RowDefinitions="Auto,*,Auto" Margin="24" MaxWidth="780" HorizontalAlignment="Stretch">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Modell wählen" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Einmaliger Download von scheisssewasser.xyz — danach komplett offline"
                                   FontSize="12" Foreground="{DynamicResource BrandSubtleTextBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="PickerCloseButton" Classes="chip" Content="&#10005;  Schließen"
                            VerticalAlignment="Top" Click="OnClosePicker" />
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <StackPanel x:Name="PickerList" Spacing="12" />
                </ScrollViewer>
                <TextBlock Grid.Row="2" x:Name="PickerError" Text="" Foreground="#DC2626"
                           TextWrapping="Wrap" Margin="0,12,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
