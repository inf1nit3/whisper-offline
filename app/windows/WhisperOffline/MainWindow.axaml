<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WhisperOffline.MainWindow"
        Title="Scheisssewasser's Whisper"
        Width="680" Height="600"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Hauptansicht -->
        <Grid x:Name="MainPanel" RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Sprache:" VerticalAlignment="Center" />
                <!-- "Automatisch" kostet einen kompletten zusätzlichen Encoder-Durchlauf -->
                <ComboBox x:Name="LanguageBox" SelectedIndex="0" Width="170">
                    <ComboBoxItem Content="Deutsch" Tag="de" />
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="Automatisch (2× so lang)" Tag="auto" />
                </ComboBox>
                <Button Content="&#59256;  Modell wechseln" Click="OnOpenModelPicker" Margin="8,0,0,0" />
                <Button Content="&#128218;  Verlauf" Click="OnOpenHistory" Margin="8,0,0,0" />
                <Button x:Name="UpdateButton" Content="&#11014;  Update" Click="OnCheckUpdate"
                        Margin="8,0,0,0" IsVisible="False" />
                <TextBlock x:Name="ModelLabel" Text="" VerticalAlignment="Center"
                           Foreground="Gray" FontSize="12" Margin="8,0,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                <Button x:Name="RecordButton" Content="&#127908;  Aufnahme starten" MinWidth="170"
                        Click="OnRecordClick" />
                <Button x:Name="FileButton" Content="&#128196;  Datei transkribieren…" MinWidth="180"
                        Click="OnFileClick" />
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Diktat-Hotkey:" VerticalAlignment="Center" />
                    <Button x:Name="HotkeyButton" MinWidth="200" Click="OnHotkeyCapture"
                            ToolTip.Tip="Anklicken, dann die gewünschte Kombination drücken" />
                    <TextBlock x:Name="HotkeyHint" VerticalAlignment="Center"
                               FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <CheckBox x:Name="AutostartBox" Content="Mit Windows starten"
                              Click="OnAutostartChanged" />
                    <CheckBox x:Name="StartMinimizedBox" Content="Minimiert starten"
                              Click="OnStartMinimizedChanged" />
                    <CheckBox x:Name="ShortCtxBox" Content="Kurzes Audio beschleunigen"
                              Click="OnShortCtxChanged"
                              ToolTip.Tip="Kürzt das Encoder-Fenster auf die Audiolänge. Experimentell — kann die Qualität kosten." />
                </StackPanel>
                <TextBlock Text="Das Fenster schließen legt die App in den Infobereich. Der Hotkey wirkt überall."
                           FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
                <TextBlock x:Name="StatusLabel" Text="" Foreground="Gray" TextWrapping="Wrap" />
                <TextBlock x:Name="EngineLabel" Text="" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
            </StackPanel>

            <TextBox Grid.Row="3" x:Name="TranscriptBox" Margin="0,12,0,0"
                     AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="False"
                     Watermark="Hier erscheint die Transkription…" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0"
                        HorizontalAlignment="Right">
                <Button Content="Kopieren" Click="OnCopyClick" />
                <Button Content="Leeren" Click="OnClearClick" />
            </StackPanel>
        </Grid>

        <!-- Verlauf -->
        <Border x:Name="HistoryPanel" IsVisible="False" Background="{DynamicResource SystemRegionBrush}">
            <Grid RowDefinitions="Auto,*,Auto" Margin="24">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                    <TextBlock x:Name="HistoryTitle" Text="Verlauf" FontSize="22"
                               FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Content="Alle löschen" Click="OnHistoryClear" />
                    <Button Content="Schließen" Click="OnHistoryClose" />
                </StackPanel>
                <ScrollViewer Grid.Row="1">
                    <StackPanel x:Name="HistoryList" Spacing="10" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Modell-Auswahl (erster Start / Wechsel) -->
        <Border x:Name="PickerPanel" IsVisible="False" Background="{DynamicResource SystemRegionBrush}">
            <Grid RowDefinitions="Auto,*,Auto" Margin="24">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                    <TextBlock Text="Modell wählen" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="Wird einmalig von deinem Server geladen" VerticalAlignment="Center"
                               Foreground="Gray" />
                    <Button x:Name="PickerCloseButton" Content="Schließen" HorizontalAlignment="Right"
                            Click="OnClosePicker" />
                </StackPanel>
                <ScrollViewer Grid.Row="1">
                    <StackPanel x:Name="PickerList" Spacing="12" />
                </ScrollViewer>
                <TextBlock Grid.Row="2" x:Name="PickerError" Text="" Foreground="Red"
                           TextWrapping="Wrap" Margin="0,12,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
